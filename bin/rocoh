#!/usr/bin/env python
import time

import mytools as t


@t.cli("roco helper")
class opts:
    list: bool = t.arg("-l", help="list all actions")
    action: str = t.arg("-a")
    hotkeys: bool = t.arg("-k", help="快捷键")


if not hasattr(opts, "edit"):
    import os
    import sys

    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", sys.executable] + sys.argv)


XY = {
