def tap(coord: tuple[int, int], delay=1.5):
    xy = " ".join(map(str, coord))
    t.cmd(f"adb shell input tap {xy}")
    time.sleep(delay)


class actions:
    def daily():
        # actions.hatch()
        actions.skin()

    def skin():
        tap(XY["MAIN"]["PANEL"], 2)
        # tap(XY["PANEL"]["STAR"])
        tap(XY["PANEL"]["SKIN"])
        tap(XY["SKIN"]["BTN.2"])
        for i in range(5):
            tap(XY["SKIN"][f"ITEM.{i + 1}"], 0.2)

    def hatch():
        tap(XY["MAIN"]["P"])
        tap(XY["PET"]["EGG"], 2)
        for _ in range(3):
            tap(XY["PET"]["EGG.OK"])
            tap(XY["PET"]["EGG.ITEM.1"])
            tap(XY["PET"]["EGG.OK"], 8)
            tap(XY["PET"]["EGG.OK"])

    def plant():
        tap(XY["MAIN"]["PANEL"], 2)
        tap(XY["PANEL"]["MAP"])
        tap(XY["MAP"]["HOUSE"])
        tap(XY["MAP"]["HOUSE.PLANT"], 8)
        tap(XY["MAIN"]["BTN.C"])

    def challenge():
        tap(XY["MAIN"]["F"])
        tap(XY["CHALLENGE"]["OK"])
        tap(XY["CHALLENGE"]["OK"], 12)
        tap(XY["FIGHT"]["SKILL.1"], 12)
        tap(XY["FIGHT"]["SKILL.2"], 13)
        tap(XY["FIGHT"]["SKILL.1"], 13)
        tap(XY["FIGHT"]["SKILL.1"], 12)
        tap(XY["FIGHT"]["BALL.1"])
        tap(XY["FIGHT"]["CAST"], 12)
        tap(XY["MAIN"]["F"])
        tap(XY["MAIN"]["F"])

    def legend():
        tap(XY["MAIN"]["F3"])
        tap(XY["F3"]["BTN.2"])
        tap(XY["F3"]["BTN.2.TYPE.3"])
        tap(XY["F3"]["BTN.2.OK.2"])
        tap(XY["MAP"]["OK"], 8)
        tap(XY["MAIN"]["PET.6"])
        tap(XY["MAIN"]["F"])
        tap(XY["CHALLENGE"]["START"])
        tap(XY["CHALLENGE"]["OK"], 5)
        tap(XY["CHALLENGE"]["SKIP"])


def main():
    if opts.list:
        print("\n".join(k for k in vars(actions) if not k.startswith("__")))
        return
    if opts.action:
        getattr(actions, opts.action)()
        return


main()

