#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "-e" ]]; then
  [ -f ~/.selected_editor ] && . ~/.selected_editor
  "${2:-${EDITOR:-${VISUAL:-$SELECTED_EDITOR}}}" "$0"
  exit 0
fi
#============================#
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
"$@"
