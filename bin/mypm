#!/usr/bin/env python
import os
import re
import shutil
import tempfile
from abc import ABC, abstractmethod
from functools import cached_property
from pathlib import Path
from typing import override

import mytools as t
from mytools import log


# package
class Package(ABC):
    @property
    def bin(self):
        return self.__class__.__name__

    @abstractmethod
    def latest(self) -> str | None: ...
    def confirm(self, version: str, changelog: str, download_url: str) -> str | None:
        if self.version == version:
            log.info(f"Already up to date: {version}")
            return
        log.info("Changelog:\n" + "\n".join(changelog.splitlines()[:20]))
        if not t.confirm(f"Update: {self.version} -> {version}"):
            return
        return download_url

    def download(self, url: str):
        filename = url.rsplit("/", 1)[-1]
        temp = tempfile.NamedTemporaryFile(
            prefix=self.bin,
            suffix=filename,
            delete=False,
        )
        t.cmd(f"curl -L -C - '{url}' -o '{temp.name}'")
        return temp

    @abstractmethod
    @cached_property
    def version(self) -> str: ...
    @abstractmethod
    def install(self, filepath: str): ...
    @abstractmethod
    def uninstall(self): ...


## source
class GitHub(Package, ABC):
    repo: str
    file: str | re.Pattern[str]
    prerelease = False
    prefix = os.getenv("GITHUB", "")

    @cached_property
    def api_url(self):
        if self.prefix:
            log.info("Get GITHUB=" + self.prefix)
        return f"{self.prefix}https://api.github.com/repos/{self.repo}/releases"

    @override
    def latest(self):
        data = F.get(
            self.api_url + ("?per_page=1" if self.prerelease else "/latest")
        ).json()
        file = self.file

        try:
            data = data[0] if self.prerelease else data
            for asset in filter(
                (lambda x: x["name"] == file)
                if isinstance(file, str)
                else (lambda x: file.search(x["name"])),
                data["assets"],
            ):
                url = super().confirm(
                    data["tag_name"].lower().lstrip("v"),
                    data["body"],
                    asset["browser_download_url"],
                )
                if url is None:
                    return
                log.info(f"Get download_url {url}")
                return url if url.startswith(self.prefix) else self.prefix + url
        except KeyError as e:
            raise ValueError(data) from e

        log.error(f"not found {self.file} on https://github.com/{self.repo}/releases")


## installer
class BIN(Package, ABC):
    @cached_property
    def binpath(self):
        return t.BINPATH / self.bin

    @override
    def install(self, filepath: str):
        """move filepath to binpath, create desktop file"""
        log.info(f"move {filepath} to {self.binpath}")
        _ = shutil.copyfile(filepath, self.binpath)
        self.binpath.chmod(self.binpath.stat().st_mode | 0o111)

        # create desktop file
        desktop_filepath = t.BINPATH.parent / f"share/applications/{self.bin}.desktop"
        if not t.confirm(f"Create {desktop_filepath}"):
            return
        if desktop_filepath.exists():
            log.info(f"Find desktop file: {desktop_filepath}, skipping creation")
            return
        _ = desktop_filepath.write_text(f"""[Desktop Entry]
Exec={self.binpath}
Name={self.bin}
Comment={input("Comment: ")}
Type=Application
Terminal=false
""")

    @override
    def uninstall(self):
        """remove binpath"""
        self.binpath.unlink()


## app
class fcitx5_pinyin_sogou_dict(GitHub):
    repo = "blackteahamburger/fcitx5-pinyin-sougou-dict"
    file = "sougou.dict"
    target = t.HOME / ".local/share/fcitx5/pinyin/dictionaries/sogou.dict"

    @override
    def install(self, filepath: str):
        self.target.parent.mkdir(parents=True, exist_ok=True)
        _ = Path(filepath).move(self.target)

    @override
    def uninstall(self):
        self.target.unlink(True)


# global
PACKAGES = {p.__name__: p for p in (fcitx5_pinyin_sogou_dict,)}
F = t.Client()


@t.cli("my package manager")
class opts:
    list: bool = t.arg("-l", help="show packages")
    install: str = t.arg("-i")
    uninstall: str = t.arg("-d")


def main():
    if opts.list:
        print("\n".join(PACKAGES.keys()))
        return
    if opts.install:
        pkg = PACKAGES[opts.install]()
        url = pkg.latest()
        if url is not None:
            tmpfile = pkg.download(url)
            pkg.install(tmpfile.name)
            import os

            os.remove(tmpfile.name)

    if opts.uninstall:
        pkg = PACKAGES[opts.uninstall]()
        pkg.uninstall()


main()
