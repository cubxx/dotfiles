server {
    listen 443 ssl;
    listen [::]:443 ssl;

    http2 on;
    ssl_certificate     $ROOT/ssl/localhost.crt;
    ssl_certificate_key $ROOT/ssl/localhost.key;

    gzip on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml;

    location /tm/ {
      alias $HOME/Projects/tampermonkey-script/;
      try_files $uri $uri/ =404;
    }

    location /crawl/ {
      alias $HOME/Projects/crawl/client/dist/;
      try_files $uri $uri/ =404;
    }
    location /crawl/api/ {
      proxy_pass http://127.0.0.1:4050/api/;
    }

    location /assetory/ {
      alias $HOME/Projects/assetory/client/dist/;
      try_files $uri $uri/ =404;
    }
    location /assetory/api/ {
      proxy_read_timeout 3600s; 
      proxy_pass http://127.0.0.1:2300/api/;
    }
}
